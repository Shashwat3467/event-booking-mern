PORT=3000
# MongoDB Atlas or a local replica set (transactions are required).
MONGO_URL=mongodb://127.0.0.1:27017/eventer?replicaSet=rs0
JWT_SECRET=replace_with_a_long_random_secret

BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=verified_sender@example.com
BREVO_FROM_NAME=EvEnter

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_admin_password
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=replace_with_user_password
